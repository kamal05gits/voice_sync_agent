# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Reasoning: Google Gemini (required for live mode) ---------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini 3.8 Flash is the default multimodal reasoning model.
GEMINI_MODEL=gemini-3.8-flash
# Automatic one-shot failover when the primary returns 503 overloaded.
# Set to an empty value to disable it.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Gemini 3 uses thinking levels. Low is the best fit for VoiceSync's
# low-latency spoken replies; use medium/high for harder tasks.
GEMINI_THINKING_LEVEL=low
# Only used when intentionally selecting a Gemini 2.5 model:
#   0   off (default)   -1  dynamic   512+  fixed budget
GEMINI_THINKING_BUDGET=0

# --- Speech: ElevenLabs (optional) -----------------------------------
# Without this the app falls back to the browser's built-in voice.
ELEVENLABS_API_KEY=
# Default is "Rachel" (21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Actions: Trello (optional, enables verified external writes) -----
# Create a Trello API key/token and choose the destination list. These values
# stay server-side; VoiceSync never sends them to the browser.
# https://developer.atlassian.com/cloud/trello/guides/rest-api/authorization/
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_LIST_ID=
# Friendly label shown in the approval dialog (the list ID is never exposed).
TRELLO_LIST_NAME=VoiceSync Follow-ups

# --- Advanced (leave unset in normal use) ----------------------------
# Override the provider hosts, e.g. for a proxy or the test doubles.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# ELEVENLABS_API_BASE=https://api.elevenlabs.io/v1
# TRELLO_API_BASE=https://api.trello.com/1
